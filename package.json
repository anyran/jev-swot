{
  "name": "jev-swot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run assets:icons && npm run verify:models",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-extension.mjs",
    "test:watch": "vitest",
    "check": "tsc -b --pretty false",
    "assets:icons": "node scripts/generate-icons.mjs",
    "assets:store": "node scripts/capture-store-assets.mjs",
    "models:fetch": "node scripts/fetch-models.mjs",
    "verify:models": "node scripts/verify-models.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "release": "npm run check && npm test && npm run verify:models && npm run build && npm run verify:build && npm run test:smoke && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "archiver": "8.0.0",
    "jsdom": "30.1.1",
    "puppeteer-core": "25.11.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
