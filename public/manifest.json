{
  "manifest_version": 3,
  "name": "JevAnswer 学习助手",
  "description": "在网页题目上显示 JEV 校准概率，并按需提供答案解析。",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "scripting", "storage", "commands", "offscreen"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "assets/background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["assets/content.js"],
    "run_at": "document_idle"
  }],
  "commands": {
    "select-question": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "框选并分析题目"
    }
  },
  "action": { "default_title": "框选并分析题目" },
  "options_page": "options.html",
  "web_accessible_resources": [{
    "resources": ["assets/*.wasm", "models/*"],
    "matches": ["<all_urls>"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
